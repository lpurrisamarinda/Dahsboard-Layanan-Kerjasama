# ============================================================
# PNBP Dashboard — Konfigurasi Environment
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke Git!
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# JWT Secret (ganti dengan string acak panjang minimal 32 karakter)
JWT_SECRET=GANTI_DENGAN_STRING_RAHASIA_YANG_PANJANG_DAN_ACAK
JWT_EXPIRES_IN=8h

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json
SPREADSHEET_ID=MASUKKAN_ID_SPREADSHEET_GOOGLE_SHEETS_ANDA

# Nama Tab di Google Sheets (sesuaikan jika berbeda)
SHEET_JADWAL=Jadwal_Siaran
SHEET_PNBP=Rekanan_PNBP
SHEET_NONPNBP=Rekanan_Non_PNBP

# Akun Admin Default (hanya untuk setup awal)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiPasswordIni123!
